<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Floating subtitle style"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Frame shape" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/shapeGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/shapeBar"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="bar"
            android:text="Wide bar" />

        <com.google.android.material.chip.Chip
            android:id="@+id/shapeCard"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="card"
            android:text="Card" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Text position" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/posGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/posTop"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="top"
            android:text="Top" />

        <com.google.android.material.chip.Chip
            android:id="@+id/posMiddle"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="middle"
            android:text="Middle" />

        <com.google.android.material.chip.Chip
            android:id="@+id/posBottom"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="bottom"
            android:text="Bottom" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Background" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/bgGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/bgSolid"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="solid"
            android:text="Solid" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bgSoft"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="soft"
            android:text="Soft panel" />

        <com.google.android.material.chip.Chip
            android:id="@+id/bgOutline"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="outline"
            android:text="Outline only" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Text color" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/textColorGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/tcCream"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#F2EDE2"
            android:text="Cream" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tcWhite"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#FFFFFF"
            android:text="White" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tcGold"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#D4A24C"
            android:text="Gold" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tcRed"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#E4574C"
            android:text="Red" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tcSky"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#7EC8E3"
            android:text="Sky blue" />

        <com.google.android.material.chip.Chip
            android:id="@+id/tcPink"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#E39BC0"
            android:text="Pink" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Panel color" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/panelColorGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/pcBlack"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#0B0E13"
            android:text="Near-black" />

        <com.google.android.material.chip.Chip
            android:id="@+id/pcNavy"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#10203A"
            android:text="Navy" />

        <com.google.android.material.chip.Chip
            android:id="@+id/pcMaroon"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#3A1016"
            android:text="Maroon" />

        <com.google.android.material.chip.Chip
            android:id="@+id/pcForest"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#10241A"
            android:text="Forest" />

        <com.google.android.material.chip.Chip
            android:id="@+id/pcPlum"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tag="#241030"
            android:text="Plum" />
    </com.google.android.material.chip.ChipGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Background opacity" />

    <SeekBar
        android:id="@+id/opacitySeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Font size" />

    <SeekBar
        android:id="@+id/fontSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="60" />

    <com.google.android.material.chip.Chip
        android:id="@+id/nextToggle"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:checkable="true"
        android:text="Show next line preview" />

    <com.google.android.material.chip.Chip
        android:id="@+id/boldToggle"
        style="@style/Widget.Material3.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:checkable="true"
        android:text="Bold text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Pinch the floating window with two fingers to resize text/panel live. Current zoom:" />

    <TextView
        android:id="@+id/scaleValueText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#D4A24C" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/resetScaleButton"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset zoom to 100%" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="#232C37" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Support link (optional, e.g. your Patreon URL)" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:hint="https://patreon.com/...">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/supportLinkInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/closeSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Done" />

</LinearLayout>
</ScrollView>
